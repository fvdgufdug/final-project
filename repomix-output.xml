      if ( (sz != 2) && (sz != 3) && (sz != 10) && (sz != 11) ) goto errorEnd; 
      stbi__skip(s,9); 
   }
   if ( stbi__get16le(s) < 1 ) goto errorEnd;      
   if ( stbi__get16le(s) < 1 ) goto errorEnd;      
   sz = stbi__get8(s);   
   if ( (tga_color_type == 1) && (sz != 8) && (sz != 16) ) goto errorEnd; 
   if ( (sz != 8) && (sz != 15) && (sz != 16) && (sz != 24) && (sz != 32) ) goto errorEnd;
