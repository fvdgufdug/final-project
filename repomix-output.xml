   if ( tga_color_type == 1 ) { 
      if (sz != 1 && sz != 9) goto errorEnd; 
      stbi__skip(s,4);       
      sz = stbi__get8(s);    
      if ( (sz != 8) && (sz != 15) && (sz != 16) && (sz != 24) && (sz != 32) ) goto errorEnd;
